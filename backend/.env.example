APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database                                                                      
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_publishable_key                                                                                           
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1                                                                      
SUPABASE_JWT_AUDIENCE=authenticated                                                                                                   
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
TAVILY_API_KEY=your_tavily_api_key
OPEN_PLACES_API_KEY=your_open_places_api_key
SERPER_API_KEY=your_serper_api_key
PAGESPEED_API_KEY=your_pagespeed_api_key
APIFY_TOKEN=your_apify_token
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-profile-scraper
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-pages-scraper
APIFY_TIKTOK_ACTOR_ID=coregent/tiktok-profile-scraper
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
GMAIL_OAUTH_FRONTEND_REDIRECT_URL=http://localhost:5173/settings
GMAIL_TOKEN_ENCRYPTION_KEY=generate_a_fernet_key
GMAIL_SEND_LIMIT_PER_DAY=25

# Comma-separated origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
